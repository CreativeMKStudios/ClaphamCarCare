---
import Icon from "./Icon.astro";
import type { Review } from "../data/business";

interface Props {
  reviews: Review[];
}
const { reviews } = Astro.props;
---

<div class="grid gap-10">
  {
    reviews.map((review) => (
      <article class="grid gap-3 border-t border-line pt-8 md:grid-cols-[180px_1fr] md:gap-8">
        <div>
          <p class="font-medium">{review.name}</p>
          <p class="mt-1 text-sm text-mute">{review.when}</p>
          <p class="mt-2 flex gap-0.5 text-signal" aria-label={`${review.stars} out of 5`}>
            {Array.from({ length: review.stars }).map(() => (
              <Icon name="star" class="size-3.5" />
            ))}
          </p>
        </div>
        <div>
          <p class="max-w-[62ch] leading-relaxed">{review.text}</p>
          {review.reply && (
            <p class="mt-4 max-w-[62ch] text-sm leading-relaxed text-mute">
              Reply from Clapham Car Care: {review.reply}
            </p>
          )}
          {review.detail && <p class="mt-3 text-xs text-mute">{review.detail}</p>}
        </div>
      </article>
    ))
  }
</div>
