---
import { path } from "../lib/path";

const current = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/services", label: "Services" },
  { href: "/projects", label: "Projects" },
  { href: "/areas", label: "Areas" },
  { href: "/contact", label: "Contact" },
];
---

<header class="sticky top-0 z-20 border-b border-line bg-ink/95 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-6 px-4">
    <a href={path("/")} class="min-w-0 leading-none">
      <span class="block text-[15px] font-semibold tracking-tight">Clapham</span>
      <span class="block text-[11px] font-medium text-mute">Car Care</span>
    </a>

    <nav class="ml-auto hidden items-center gap-5 lg:flex" aria-label="Main">
      {
        links.map((link) => {
          const href = path(link.href);
          const active = current === href;
          return (
            <a
              href={href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "text-sm",
                active ? "text-paper" : "text-mute hover:text-paper",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <a
        href={path("/contact")}
        class="inline-flex h-10 items-center rounded-full bg-signal px-4 text-sm font-semibold text-white transition-transform duration-150 hover:bg-signal-press active:scale-[0.98]"
      >
        Book a wash
      </a>
    </nav>

    <details class="group relative ml-auto lg:hidden">
      <summary
        class="flex h-10 cursor-pointer list-none items-center rounded-full border border-line px-4 text-sm font-medium [&::-webkit-details-marker]:hidden"
      >
        Menu
      </summary>
      <nav
        class="absolute right-0 top-12 z-30 w-56 rounded-2xl border border-line bg-raised p-2 shadow-[0_16px_40px_rgba(0,0,0,0.45)]"
        aria-label="Mobile"
      >
        {
          links.map((link) => (
            <a href={path(link.href)} class="block rounded-xl px-3 py-2.5 text-sm hover:bg-ink">
              {link.label}
            </a>
          ))
        }
        <a
          href={path("/contact")}
          class="mt-1 flex h-10 items-center justify-center rounded-full bg-signal text-sm font-semibold text-white"
        >
          Book a wash
        </a>
      </nav>
    </details>
  </div>
</header>
