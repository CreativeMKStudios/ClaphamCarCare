---
import Base from "../layouts/Base.astro";
import { areas, business } from "../data/business";
import { absolute } from "../lib/path";

const description =
  "Clapham Car Care is at 95 High Street, Clapham, Bedford. Drivers come from Oakley, Bromham, Bedford, Kempston, and the villages nearby.";

const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: absolute("/") },
    { "@type": "ListItem", position: 2, name: "Areas", item: absolute("/areas") },
  ],
};
---

<Base title="Villages that use the bay" description={description} schema={crumbs}>
  <article class="mx-auto max-w-7xl px-4 py-12 md:py-16">
    <h1 class="max-w-3xl text-4xl font-semibold tracking-tight md:text-6xl">You drive to us.</h1>
    <p class="mt-6 max-w-[62ch] text-lg leading-relaxed text-mute">
      The wash is at {business.address.street}, {business.address.locality}. Distances below are roughly how far each place is from the bay, as the crow flies. The road can be a little longer.
    </p>
    <div class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-2">
      {
        areas.map((area) => (
          <section>
            <h2 class="text-2xl font-semibold tracking-tight">{area.name}</h2>
            <p class="mt-1 text-sm text-signal-text">{area.miles}</p>
            <p class="mt-3 max-w-[46ch] leading-relaxed text-mute">{area.text}</p>
          </section>
        ))
      }
    </div>
    <p class="mt-14 max-w-[62ch] text-sm leading-relaxed text-mute">
      If your village is not on this list, call {business.phoneDisplay}. We will tell you if the drive makes sense. We do not run a mobile wash.
    </p>
  </article>
</Base>
