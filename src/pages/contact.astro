---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { addressLine, business, extras, levelOne } from "../data/business";
import { absolute } from "../lib/path";

const description =
  "Book a wash at Clapham Car Care, 95 High Street, Clapham, Bedford, MK41 6AQ. Call or text 07530 077007. Open seven days.";

const options = [
  "Level 1 wash",
  ...extras.map((item) => item.name),
  "Sell a car, van, or motorbike",
  "Not sure yet",
];

const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: absolute("/") },
    { "@type": "ListItem", position: 2, name: "Contact", item: absolute("/contact") },
  ],
};

const mapSrc = `https://maps.google.com/maps?q=${business.geo.lat},${business.geo.lng}&z=16&output=embed`;
---

<Base title="Book a wash" description={description} schema={crumbs}>
  <article class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-12 px-4 py-12 md:py-16 lg:grid-cols-12">
    <div class="min-w-0 lg:col-span-5">
      <h1 class="text-4xl font-semibold tracking-tight md:text-6xl">Book a wash</h1>
      <p class="mt-5 max-w-[40ch] text-lg leading-relaxed text-mute">
        Call or text. We confirm the price before any extra work starts.
      </p>
      <a
        href={`tel:${business.phoneTel}`}
        class="mt-8 inline-flex h-12 items-center gap-2 rounded-full bg-signal px-5 font-semibold text-white"
      >
        <Icon name="phone" class="size-4" />
        {business.phoneDisplay}
      </a>
      <dl class="mt-10 grid gap-6 text-sm">
        <div>
          <dt class="text-mute">Address</dt>
          <dd class="mt-1">{addressLine()}</dd>
          <dd class="text-mute">Plus code {business.plusCode}</dd>
        </div>
        <div>
          <dt class="text-mute">Hours</dt>
          <dd class="mt-1">Monday to Saturday, 9:30am to 6pm</dd>
          <dd>Sunday, 10am to 4pm</dd>
        </div>
        <div>
          <dt class="text-mute">Level 1</dt>
          <dd class="mt-1">{levelOne.prices.map((row) => `${row.name}: ${row.price}`).join(". ")}.</dd>
        </div>
      </dl>
    </div>

    <form id="book" class="grid w-full min-w-0 grid-cols-1 gap-5 lg:col-span-7 [&>*]:min-w-0" novalidate>
      <div class="grid gap-2">
        <label for="name" class="text-sm font-medium">Your name</label>
        <input id="name" name="name" autocomplete="name" required class="h-12 rounded-xl border border-[#8a8a84] bg-raised px-4 text-paper" />
        <p id="name-error" class="hidden text-sm text-signal-text" role="alert"></p>
      </div>
      <div class="grid gap-2">
        <label for="phone" class="text-sm font-medium">Phone</label>
        <p id="phone-help" class="text-sm text-mute">The number we should call or text.</p>
        <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required aria-describedby="phone-help" class="h-12 rounded-xl border border-[#8a8a84] bg-raised px-4 text-paper" />
        <p id="phone-error" class="hidden text-sm text-signal-text" role="alert"></p>
      </div>
      <div class="grid gap-2">
        <label for="vehicle" class="text-sm font-medium">Vehicle</label>
        <p id="vehicle-help" class="text-sm text-mute">Make, model, and size is enough.</p>
        <input id="vehicle" name="vehicle" autocomplete="off" aria-describedby="vehicle-help" class="h-12 rounded-xl border border-[#8a8a84] bg-raised px-4 text-paper" />
      </div>
      <div class="grid gap-2">
        <label for="job" class="text-sm font-medium">What do you need?</label>
        <select id="job" name="job" required class="h-12 w-full min-w-0 rounded-xl border border-[#8a8a84] bg-raised px-4 text-paper">
          <option value="">Choose one</option>
          {options.map((option) => <option value={option}>{option}</option>)}
        </select>
        <p id="job-error" class="hidden text-sm text-signal-text" role="alert"></p>
      </div>
      <div class="grid gap-2">
        <label for="note" class="text-sm font-medium">Anything we should know</label>
        <textarea id="note" name="note" rows="4" class="rounded-xl border border-[#8a8a84] bg-raised px-4 py-3 text-paper"></textarea>
      </div>
      <button
        type="submit"
        class="inline-flex h-12 w-fit items-center rounded-full bg-signal px-6 font-semibold text-white active:scale-[0.98]"
      >
        Prepare a text
      </button>
      <p id="form-success" class="hidden max-w-[48ch] leading-relaxed" role="status"></p>
    </form>
  </article>

  <section class="border-t border-line" aria-label="Map">
    <iframe
      title="Map of Clapham Car Care at 95 High Street, Clapham"
      src={mapSrc}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="h-80 w-full border-0 grayscale"
    ></iframe>
  </section>

  <script define:vars={{ phone: business.phoneTel, display: business.phoneDisplay }}>
    const form = document.querySelector("#book");
    const success = document.querySelector("#form-success");
    const fields = [
      ["name", "Add your name so we know who to ask for."],
      ["phone", "Add a phone number we can call or text."],
      ["job", "Choose the work you want, or pick Not sure yet."],
    ];

    function showError(id, message) {
      const el = document.querySelector("#" + id + "-error");
      const input = document.querySelector("#" + id);
      if (!el || !input) return;
      el.textContent = message;
      el.classList.toggle("hidden", !message);
      input.setAttribute("aria-invalid", message ? "true" : "false");
    }

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      let invalid = false;
      const data = new FormData(form);
      for (const [id, message] of fields) {
        const value = String(data.get(id) || "").trim();
        const badPhone = id === "phone" && value.replace(/\D/g, "").length < 10;
        if (!value) {
          showError(id, message);
          invalid = true;
        } else if (badPhone) {
          showError(id, "That phone number looks too short.");
          invalid = true;
        } else {
          showError(id, "");
        }
      }
      if (invalid) {
        success.classList.add("hidden");
        return;
      }
      const lines = [
        "Clapham Car Care booking",
        "Name: " + data.get("name"),
        "Phone: " + data.get("phone"),
        "Vehicle: " + (data.get("vehicle") || "not given"),
        "Job: " + data.get("job"),
        "Note: " + (data.get("note") || "none"),
      ];
      const body = encodeURIComponent(lines.join("\n"));
      const link = document.createElement("a");
      link.href = "sms:" + phone + "?&body=" + body;
      link.textContent = "Text " + display;
      link.className = "mt-3 inline-flex h-11 items-center rounded-full bg-signal px-5 font-semibold text-white";
      success.replaceChildren();
      success.classList.remove("hidden");
      success.append(document.createTextNode("Your note is ready. This page does not send it for you. Call " + display + ", or text it from your phone. "));
      success.append(link);
    });
  </script>
</Base>
