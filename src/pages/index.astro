---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { business, levelOne } from "../data/business";
import hero from "../assets/photos/lambo-doors.jpg";
import board from "../assets/photos/level1-board.jpg";
import foam from "../assets/photos/rolls-foam.jpg";
import side from "../assets/photos/rolls-side.jpg";
import m5 from "../assets/photos/bmw-m5.jpg";
import interior from "../assets/photos/bmw-interior.jpg";

const sideQuotes = [
  {
    text: "Very happy with the finish, and with the products used. I had a Level 3 clean and will be back.",
    name: "hayabusa nutter",
    when: "3 months ago",
  },
  {
    text: "They were very polite, and very professional. My car looks amazing.",
    name: "Mohit Sharma",
    when: "a year ago",
  },
];

const description =
  "Hand car wash on Clapham High Street, Bedford. Level 1 is £15 for a small or medium car. Open seven days. Call 07530 077007.";
---

<Base title="Hand car wash in Clapham, Bedford" description={description}>
  <section class="mx-auto grid min-h-[calc(100dvh-4rem)] max-w-7xl items-center gap-10 px-4 py-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:py-8">
    <div class="hero-copy max-w-xl">
      <p class="flex items-center gap-3 text-sm text-mute">
        <span class="h-px w-8 bg-signal" aria-hidden="true"></span>
        Clapham High Street
      </p>
      <h1 class="mt-5 text-5xl font-semibold leading-[1.05] tracking-tight md:text-6xl">
        Washed by hand. Ready to drive.
      </h1>
      <p class="mt-5 max-w-[40ch] text-lg leading-relaxed text-mute">
        Level 1 starts at £15 on Clapham High Street, Bedford.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/contact"
          class="inline-flex h-12 items-center rounded-full bg-signal px-6 text-base font-semibold text-white transition-transform duration-150 hover:bg-signal-press active:scale-[0.98]"
        >
          Book a wash
        </a>
        <a href="/projects" class="inline-flex h-12 items-center gap-2 text-base font-medium">
          See the work
          <Icon name="arrow" class="size-4" />
        </a>
      </div>
    </div>
    <Image
      src={hero}
      alt="A black Lamborghini with the doors up in front of the Clapham Car Care sign."
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 1024px) 54vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="h-auto w-full rounded-2xl object-cover"
    />
  </section>

  <section class="border-t border-line">
    <div class="mx-auto max-w-7xl px-4 py-16 md:py-24">
      <h2 class="max-w-xl text-3xl font-semibold tracking-tight md:text-5xl">Level 1, priced on the board.</h2>
      <p class="mt-4 max-w-[46ch] text-base leading-relaxed text-mute">
        A hand wash for daily drivers. We tell you the price before we start.
      </p>
      <div class="mt-10 grid items-start gap-6 lg:grid-cols-12">
        <Image
          src={board}
          alt="The Level 1 package board at Clapham Car Care, with prices for small cars and larger vehicles."
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 58vw, 100vw"
          class="h-auto w-full rounded-2xl lg:col-span-7"
        />
        <div class="grid gap-6 lg:col-span-5">
          <div class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl bg-line">
            {
              levelOne.prices.map((row) => (
                <div class="bg-raised p-5">
                  <p class="text-3xl font-semibold tracking-tight">{row.price}</p>
                  <p class="mt-2 text-sm leading-snug text-mute">{row.name}</p>
                </div>
              ))
            }
          </div>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
            {
              levelOne.includes.map((item) => (
                <li class="flex items-start gap-2">
                  <Icon name="check" class="mt-0.5 size-4 text-signal" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
          <p class="text-sm text-mute">{levelOne.note}</p>
          <a href="/services" class="inline-flex items-center gap-2 text-sm font-medium">
            Extras and the full list
            <Icon name="arrow" class="size-4" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-raised">
    <div class="mx-auto max-w-7xl px-4 py-16 md:py-24">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-3xl font-semibold tracking-tight md:text-5xl">What drivers wrote.</h2>
        <p class="text-sm text-mute">
          {business.rating} from {business.reviewCount} Google reviews
        </p>
      </div>
      <div class="mt-10 grid gap-8 lg:grid-cols-12">
        <blockquote class="lg:col-span-7">
          <div class="flex gap-1 text-signal" aria-label="5 out of 5">
            {Array.from({ length: 5 }).map(() => <Icon name="star" class="size-4" />)}
          </div>
          <p class="mt-4 text-2xl font-medium leading-snug tracking-tight md:text-3xl">
            “An excellent and friendly service, all costs are transparent, so you won't be shocked.”
          </p>
          <footer class="mt-5 text-sm text-mute">Ian Joseph, Google review, 5 months ago</footer>
        </blockquote>
        <div class="grid gap-8 lg:col-span-5">
          {
            sideQuotes.map((review) => (
              <blockquote class="border-t border-line pt-6">
                <p class="leading-relaxed">“{review.text}”</p>
                <footer class="mt-3 text-sm text-mute">
                  {review.name}, Google review, {review.when}
                </footer>
              </blockquote>
            ))
          }
        </div>
      </div>
      <a href="/about#reviews" class="mt-10 inline-flex items-center gap-2 text-sm font-medium">
        Read the Google reviews
        <Icon name="arrow" class="size-4" />
      </a>
    </div>
  </section>

  <section class="border-t border-line" aria-label="Recent cars">
    <div class="mx-auto max-w-7xl px-4 py-16 md:py-24">
      <h2 class="text-3xl font-semibold tracking-tight md:text-5xl">Cars from the bay.</h2>
      <div class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2">
        <Image src={foam} alt="A silver Rolls-Royce in wash foam outside the Clapham Car Care bay." widths={[480, 800]} sizes="70vw" class="h-72 w-[78%] shrink-0 snap-start rounded-2xl object-cover sm:w-[46%] lg:h-80 lg:w-[32%]" />
        <Image src={side} alt="Foam running off a Rolls-Royce on the Clapham Car Care forecourt." widths={[480, 800]} sizes="70vw" class="h-72 w-[78%] shrink-0 snap-start rounded-2xl object-cover sm:w-[46%] lg:h-80 lg:w-[32%]" />
        <Image src={m5} alt="A blue BMW M5 after a wash outside the Clapham bay." widths={[480, 800]} sizes="70vw" class="h-72 w-[78%] shrink-0 snap-start rounded-2xl object-cover sm:w-[46%] lg:h-80 lg:w-[32%]" />
        <Image src={interior} alt="Red and black leather seats in a BMW after an interior clean." widths={[480, 800]} sizes="70vw" class="h-72 w-[78%] shrink-0 snap-start rounded-2xl object-cover sm:w-[46%] lg:h-80 lg:w-[32%]" />
      </div>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 md:grid-cols-3 md:py-24">
      <div>
        <h2 class="text-3xl font-semibold tracking-tight">Come to the bay.</h2>
        <p class="mt-4 text-sm leading-relaxed text-mute">
          We do not come to your drive. You bring the car to 95 High Street.
        </p>
      </div>
      <div>
        <p class="flex items-center gap-2 text-sm font-medium">
          <Icon name="mapPin" class="size-4 text-signal" />
          {business.address.street}
        </p>
        <p class="mt-2 pl-6 text-sm text-mute">
          {business.address.locality}, {business.address.region} {business.address.postcode}
        </p>
        <a class="mt-4 inline-flex pl-6 text-sm font-medium" href="/areas">Villages nearby</a>
      </div>
      <div>
        <p class="flex items-center gap-2 text-sm font-medium">
          <Icon name="clock" class="size-4 text-signal" />
          Seven days
        </p>
        <p class="mt-2 pl-6 text-sm text-mute">Mon to Sat, 9:30am to 6pm</p>
        <p class="pl-6 text-sm text-mute">Sunday, 10am to 4pm</p>
        <a class="mt-4 inline-flex h-11 items-center rounded-full bg-signal px-5 text-sm font-semibold text-white" href="/contact">
          Book a wash
        </a>
      </div>
    </div>
  </section>
</Base>
