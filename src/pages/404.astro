---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="That page is not on the Clapham Car Care site. Go back to the High Street bay, the services, or book a wash.">
  <section class="mx-auto max-w-3xl px-4 py-24">
    <h1 class="text-4xl font-semibold tracking-tight md:text-6xl">That page is not here.</h1>
    <p class="mt-5 max-w-[40ch] text-lg leading-relaxed text-mute">
      The bay is still at 95 High Street. Try the home page, or book a wash.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="inline-flex h-12 items-center rounded-full border border-line px-5 font-medium">Home</a>
      <a href="/contact" class="inline-flex h-12 items-center rounded-full bg-signal px-5 font-semibold text-white">Book a wash</a>
    </div>
  </section>
</Base>
